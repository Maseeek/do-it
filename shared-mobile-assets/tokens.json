{
  "$schema": "https://json.schemastore.org/design-tokens",
  "name": "Do It Mobile Design Tokens",
  "version": "1.0.0",
  "theme": "Linear Dark",
  "description": "Cross-platform design token specifications for Do It native iOS (SwiftUI) and Android (Jetpack Compose / XML).",
  "color": {
    "background": {
      "base": { "value": "#08090a", "description": "Obsidian base canvas background" },
      "subtle": { "value": "#0c0e12", "description": "Slightly elevated page background" },
      "surface0": { "value": "#08090a", "description": "Lowest level canvas" },
      "surface1": { "value": "#0e1013", "description": "Default card and container surface" },
      "surface2": { "value": "#16181d", "description": "Hovered, nested, or secondary surface" },
      "surface3": { "value": "#22252b", "description": "Active, pressed, or raised modal surface" },
      "elevated": { "value": "#2a2e36", "description": "Floating sheets, tooltips, dialogs" },
      "overlay": { "value": "rgba(8, 9, 10, 0.82)", "description": "Scrim / backdrop overlay" }
    },
    "border": {
      "subtle": { "value": "rgba(255, 255, 255, 0.08)", "description": "Default hair border for cards" },
      "medium": { "value": "rgba(255, 255, 255, 0.15)", "description": "Hover, interactive borders" },
      "strong": { "value": "rgba(255, 255, 255, 0.25)", "description": "Focused, active states" },
      "accentGlow": { "value": "rgba(96, 165, 250, 0.35)", "description": "Player focus glow" }
    },
    "text": {
      "primary": { "value": "#f5f6f8", "description": "Highest hierarchy headings and active copy" },
      "secondary": { "value": "#9ba1b0", "description": "Secondary labels and descriptions" },
      "muted": { "value": "#676f82", "description": "Muted metadata, timestamps, placeholders" },
      "disabled": { "value": "#424856", "description": "Inactive or disabled states" },
      "inverse": { "value": "#08090a", "description": "Contrasting text on solid white buttons" }
    },
    "brand": {
      "accent": { "value": "#6366f1", "description": "Electric Indigo signature accent" },
      "accentGradientStart": { "value": "#38bdf8", "description": "Cyan neon leading edge" },
      "accentGradientEnd": { "value": "#818cf8", "description": "Violet neon trailing edge" },
      "neonCore": { "value": "#ffffff", "description": "High-intensity white highlight core" },
      "logoTile": { "value": "#ffffff", "description": "Icon tile background" },
      "logoText": { "value": "#09090b", "description": "Icon tile foreground glyph" }
    },
    "status": {
      "emerald": {
        "hex": "#10b981",
        "glow": "rgba(16, 185, 129, 0.25)",
        "surface": "rgba(16, 185, 129, 0.12)",
        "border": "rgba(16, 185, 129, 0.30)",
        "text": "#34d399",
        "description": "Daily Par completed & health sync success"
      },
      "amber": {
        "hex": "#f59e0b",
        "glow": "rgba(245, 158, 11, 0.25)",
        "surface": "rgba(245, 158, 11, 0.12)",
        "border": "rgba(245, 158, 11, 0.30)",
        "text": "#fbbf24",
        "description": "Active duel stakes & urgency warning"
      },
      "crimson": {
        "hex": "#ef4444",
        "glow": "rgba(239, 68, 68, 0.25)",
        "surface": "rgba(239, 68, 68, 0.12)",
        "border": "rgba(239, 68, 68, 0.30)",
        "text": "#f87171",
        "description": "Missed streak / duel loss"
      },
      "cyan": {
        "hex": "#06b6d4",
        "glow": "rgba(6, 182, 212, 0.25)",
        "surface": "rgba(6, 182, 212, 0.12)",
        "border": "rgba(6, 182, 212, 0.30)",
        "text": "#22d3ee",
        "description": "Real-time sync and pairing status"
      }
    },
    "players": {
      "blue": {
        "hex": "#60a5fa",
        "bg": "rgba(96, 165, 250, 0.10)",
        "border": "rgba(96, 165, 250, 0.25)",
        "glow": "rgba(96, 165, 250, 0.35)"
      },
      "purple": {
        "hex": "#c084fc",
        "bg": "rgba(192, 132, 252, 0.10)",
        "border": "rgba(192, 132, 252, 0.25)",
        "glow": "rgba(192, 132, 252, 0.35)"
      },
      "teal": {
        "hex": "#2dd4bf",
        "bg": "rgba(45, 212, 191, 0.10)",
        "border": "rgba(45, 212, 191, 0.25)",
        "glow": "rgba(45, 212, 191, 0.35)"
      },
      "orange": {
        "hex": "#fb923c",
        "bg": "rgba(251, 146, 60, 0.10)",
        "border": "rgba(251, 146, 60, 0.25)",
        "glow": "rgba(251, 146, 60, 0.35)"
      },
      "pink": {
        "hex": "#f472b6",
        "bg": "rgba(244, 114, 182, 0.10)",
        "border": "rgba(244, 114, 182, 0.25)",
        "glow": "rgba(244, 114, 182, 0.35)"
      },
      "green": {
        "hex": "#4ade80",
        "bg": "rgba(74, 222, 128, 0.10)",
        "border": "rgba(74, 222, 128, 0.25)",
        "glow": "rgba(74, 222, 128, 0.35)"
      },
      "rainbow": {
        "hex": "#f0abfc",
        "bg": "rgba(232, 121, 249, 0.10)",
        "border": "rgba(232, 121, 249, 0.30)",
        "glow": "rgba(232, 121, 249, 0.40)"
      },
      "gold": {
        "hex": "#eab308",
        "bg": "rgba(234, 179, 8, 0.10)",
        "border": "rgba(234, 179, 8, 0.25)",
        "glow": "rgba(234, 179, 8, 0.40)"
      }
    },
    "categories": {
      "foundation": {
        "accent": "#818cf8",
        "background": "rgba(129, 140, 248, 0.12)",
        "border": "rgba(129, 140, 248, 0.28)",
        "label": "Foundation (Sleep & Circadian)"
      },
      "physical": {
        "accent": "#f97316",
        "background": "rgba(249, 115, 22, 0.12)",
        "border": "rgba(249, 115, 22, 0.28)",
