      },
      "language": {
        "accent": "#06b6d4",
        "background": "rgba(6, 182, 212, 0.12)",
        "border": "rgba(6, 182, 212, 0.28)",
        "label": "Language (Vocabulary & Fluency)"
      },
      "nutrition": {
        "accent": "#22c55e",
        "background": "rgba(34, 197, 94, 0.12)",
        "border": "rgba(34, 197, 94, 0.28)",
        "label": "Nutrition (Clean Fuel & Water)"
      },
      "environment": {
        "accent": "#10b981",
        "background": "rgba(16, 185, 129, 0.12)",
        "border": "rgba(16, 185, 129, 0.28)",
        "label": "Environment (Space & Sanctuary)"
      },
      "finance": {
        "accent": "#eab308",
        "background": "rgba(234, 179, 8, 0.12)",
        "border": "rgba(234, 179, 8, 0.28)",
        "label": "Finance (Budgeting & Investing)"
      }
    }
  },
  "typography": {
    "fontFamily": {
      "display": "system-ui, -apple-system, 'SF Pro Display', Inter, Roboto, sans-serif",
      "body": "system-ui, -apple-system, 'SF Pro Text', Inter, Roboto, sans-serif",
      "mono": "'SF Mono', 'Geist Mono', 'JetBrains Mono', Menlo, Consolas, monospace"
    },
    "scales": {
      "display": {
        "fontSize": 34,
        "lineHeight": 41,
        "fontWeight": 700,
        "letterSpacing": -0.8
      },
      "titleLarge": {
        "fontSize": 24,
        "lineHeight": 30,
        "fontWeight": 700,
        "letterSpacing": -0.6
      },
      "titleMedium": {
        "fontSize": 20,
        "lineHeight": 26,
        "fontWeight": 600,
        "letterSpacing": -0.4
      },
      "headline": {
        "fontSize": 17,
        "lineHeight": 22,
        "fontWeight": 600,
        "letterSpacing": -0.3
      },
      "bodyLarge": {
        "fontSize": 16,
        "lineHeight": 22,
        "fontWeight": 400,
        "letterSpacing": -0.2
      },
      "bodyMedium": {
        "fontSize": 14,
        "lineHeight": 20,
        "fontWeight": 400,
        "letterSpacing": -0.1
      },
      "bodySmall": {
        "fontSize": 12,
        "lineHeight": 16,
        "fontWeight": 400,
        "letterSpacing": 0.0
      },
      "caption": {
        "fontSize": 11,
        "lineHeight": 14,
        "fontWeight": 500,
        "letterSpacing": 0.1
      },
      "monoMetric": {
        "fontSize": 18,
        "lineHeight": 22,
        "fontWeight": 700,
        "letterSpacing": -0.5
      }
    }
  },
  "spacing": {
    "2xs": 2,
    "xs": 4,
    "sm": 8,
    "md": 12,
    "lg": 16,
    "xl": 20,
    "2xl": 24,
    "3xl": 32,
    "4xl": 40,
    "5xl": 48,
    "6xl": 64
  },
  "radii": {
    "none": 0,
    "xs": 4,
    "sm": 8,
    "md": 12,
    "lg": 16,
    "xl": 20,
    "2xl": 24,
    "3xl": 32,
    "full": 9999
  },
  "borders": {
    "hair": 0.5,
    "thin": 1.0,
    "medium": 2.0,
    "thick": 3.0
  },
  "shadows": {
    "subtle": {
      "color": "rgba(0, 0, 0, 0.45)",
      "x": 0,
      "y": 2,
      "blur": 8,
      "spread": 0
    },
    "card": {
      "color": "rgba(0, 0, 0, 0.65)",
      "x": 0,
      "y": 8,
      "blur": 24,
      "spread": 0
    },
    "glowEmerald": {
      "color": "rgba(16, 185, 129, 0.28)",
      "x": 0,
      "y": 0,
      "blur": 16,
      "spread": 2
    },
    "glowAmber": {
      "color": "rgba(245, 158, 11, 0.28)",
      "x": 0,
      "y": 0,
      "blur": 16,
      "spread": 2
    },
    "glowNeon": {
      "color": "rgba(99, 102, 241, 0.35)",
      "x": 0,
      "y": 0,
      "blur": 20,
      "spread": 4
    }
  },
  "motion": {
    "durationFast": 150,
    "durationNormal": 250,
    "durationSmooth": 350,
    "easingDecel": "cubic-bezier(0.0, 0.0, 0.2, 1.0)",
    "springStiffness": 380,
    "springDamping": 28
  }
}
