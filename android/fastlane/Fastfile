# frozen_string_literal: true

default_platform(:android)

platform :android do
  before_all do
    # Locate Gradle root directory
    @android_root = File.expand_path("..", __dir__)
    @gradle_project_dir = if File.exist?(File.join(@android_root, "DoIt", "build.gradle.kts")) || File.exist?(File.join(@android_root, "DoIt", "build.gradle"))
                            File.join(@android_root, "DoIt")
                          elsif File.exist?(File.join(@android_root, "build.gradle.kts")) || File.exist?(File.join(@android_root, "build.gradle"))
                            @android_root
                          else
                            File.join(@android_root, "DoIt")
                          end
  end

  desc "Run unit tests"
  lane :test do
    gradle(
      task: "testDebugUnitTest",
      project_dir: @gradle_project_dir,
      flags: "--no-daemon --stacktrace"
    )
  end

  desc "Assemble Debug APK"
  lane :assemble do
    gradle(
      task: "assembleDebug",
      project_dir: @gradle_project_dir,
      flags: "--no-daemon --stacktrace"
    )
  end

  desc "Build Release APK and Android App Bundle (AAB)"
  lane :build do
    gradle(
      tasks: ["assembleRelease", "bundleRelease"],
      project_dir: @gradle_project_dir,
      flags: "--no-daemon --stacktrace"
    )
  end

  desc "Build AAB and deploy to Google Play Internal Testing track"
  lane :beta do |options|
    ensure_git_status_clean unless ENV["SKIP_GIT_CHECK"] == "true"

    # Run unit tests before building
    test unless options[:skip_tests]

    # Build release AAB
    gradle(
      task: "bundleRelease",
      project_dir: @gradle_project_dir,
      flags: "--no-daemon --stacktrace"
    )

    # Locate generated AAB
    aab_candidates = Dir.glob(File.join(@gradle_project_dir, "app", "build", "outputs", "bundle", "release", "*.aab")) +
                     Dir.glob(File.join(@android_root, "**", "*.aab"))
    aab_path = aab_candidates.first

    UI.user_error!("Could not find generated AAB file for upload") unless aab_path && File.exist?(aab_path)

    supply_config = {
      track: "internal",
      aab: aab_path,
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      release_status: "completed"
    }

    if ENV["SUPPLY_JSON_KEY_DATA"]
      supply_config[:json_key_data] = ENV["SUPPLY_JSON_KEY_DATA"]
    elsif ENV["SUPPLY_JSON_KEY_FILE"]
      supply_config[:json_key] = ENV["SUPPLY_JSON_KEY_FILE"]
    end

    upload_to_play_store(supply_config)
  end
end
