# Supabase account and duel storage
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# Public app URL and Google Health OAuth
GOOGLE_HEALTH_ENABLED=false
# Optional private rollout: comma-separated Supabase Auth user IDs, never emails or duel slots.
# Keep GOOGLE_HEALTH_ENABLED=false to restrict access to these accounts.
GOOGLE_HEALTH_ALLOWED_USER_IDS=
NEXT_PUBLIC_APP_URL=http://localhost:3000
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Generate 32 random bytes and encode with base64. Keep this server-only.
HEALTH_TOKEN_ENCRYPTION_KEY=your-base64-encoded-32-byte-key
CRON_SECRET=your-secure-cron-secret

# Stripe subscriptions (server-only). Start with sandbox credentials.
# The account ID must match the account that owns these prices.
STRIPE_SECRET_KEY=
STRIPE_ACCOUNT_ID=
STRIPE_WEBHOOK_SECRET=
# Recurring prices on a product with metadata app=do-it.
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=
# Optional saved customer portal configuration ID (bpc_...).
STRIPE_PORTAL_CONFIGURATION=
# Enable only after testing and confirming your live prices.
BILLING_LIVE_ENABLED=false
