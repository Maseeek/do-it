# Supabase account and duel storage
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# Public app URL and Google Health OAuth
GOOGLE_HEALTH_ENABLED=false
NEXT_PUBLIC_APP_URL=http://localhost:3000
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Generate 32 random bytes and encode with base64. Keep this server-only.
HEALTH_TOKEN_ENCRYPTION_KEY=your-base64-encoded-32-byte-key
CRON_SECRET=your-secure-cron-secret

