# Optional: Supabase Cloud Sync
# You can set these in .env.local or in your Vercel Project Settings > Environment Variables
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# Wearables & Health Integrations
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Maciek: Google Health / Fitness API (Google Cloud Console OAuth 2.0 Credentials)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Myrna: Apple Health (iOS Shortcuts Webhook Authentication Secret)
APPLE_HEALTH_SECRET=your-secure-shared-secret-key

